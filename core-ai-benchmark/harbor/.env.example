# Optional overrides for core-ai-benchmark/harbor/run.sh and run.ps1.
# Copy to .env only when you need to override the defaults.

# By default the active entry in ~/.core-ai/auth.json (written by
# `core-ai-cli --login`) supplies both values. Uncomment to override.
# LITELLM_API_BASE=https://core-ai-server.example.com/api/cli/v1
# LITELLM_API_KEY=sk-xxx

# Model in provider/model form. Set it to a model available on your server.
MODEL=litellm/deepseek-flash

# Reasoning effort passed to the model: none|low|medium|high|max.
THINKING_EFFORT=max

# Trials per task (official leaderboard uses 5; local quick runs use 1).
TRIALS=1

# Concurrent trials. Raise only after increasing Docker Desktop memory.
CONCURRENCY=1

# Terminal-Bench 2.1 dataset checkout. The runner clones it automatically
# when the directory is missing.
# TB21_DATASET_DIR=core-ai-benchmark/harbor/.datasets/terminal-bench-2-1
# Pin a dataset commit for reproducible comparisons:
# TB21_DATASET_REF=7131e4375048a0e408a8fb404b5f499d726b695b

# core-ai-cli Linux native binary. The runner downloads this release when
# CORE_AI_CLI_BINARY is not set.
# CORE_AI_CLI_VERSION=2.0.52
# CORE_AI_CLI_BINARY=core-ai-benchmark/harbor/.cache/core-ai-cli-linux

# Harbor executable and results directory.
# HARBOR=harbor
# HARBOR_JOBS_DIR=core-ai-benchmark/harbor/.harbor-jobs
