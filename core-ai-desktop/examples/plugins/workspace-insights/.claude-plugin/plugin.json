{
  "name": "Workspace Insights",
  "version": "0.1.0",
  "description": "A read-only plugin page for workspace, session, memory and live event data.",
  "coreai": {
    "schemaVersion": 1,
    "id": "core-ai.workspace-insights",
    "desktopApi": "^1.0.0",
    "capabilities": {
      "required": ["ui.pages", "ui.slots", "ui.renderers", "artifacts.read", "tools.register", "sessions.read", "memory.read", "memory.write", "workspace.read", "usage.read", "plugin.storage", "events.read", "notification.send"]
    },
    "contributes": {
      "pages": [
        {
          "id": "insights",
          "title": "Workspace Insights",
          "view": "pages/insights.html",
          "scope": "workspace"
        }
      ],
      "slots": [
        {
          "id": "open-insights",
          "slot": "sidebar.footer.action",
          "title": "Workspace Insights",
          "action": { "kind": "openPage", "pageId": "insights" }
        },
        {
          "id": "review-workspace",
          "slot": "composer.dock",
          "title": "Review workspace",
          "action": { "kind": "insertText", "text": "Review this workspace's recent sessions and usage." }
        },
        {
          "id": "turn-insights",
          "slot": "conversation.turn.tail",
          "title": "Insights",
          "action": { "kind": "openPage", "pageId": "insights" }
        },
        {
          "id": "message-insights",
          "slot": "conversation.message.actions",
          "title": "Review in Insights",
          "action": { "kind": "insertText", "text": "Review this message in Workspace Insights." }
        }
      ],
      "renderers": [
        {
          "id": "text-viewer",
          "kind": "artifact",
          "title": "Insights",
          "pageId": "insights",
          "extensions": [".md", ".txt", ".json", ".log"]
        }
      ],
      "tools": [
        {
          "id": "artifacts",
          "name": "list_artifacts",
          "description": "List generated artifacts in the current workspace.",
          "operation": "artifacts.list",
          "limit": 30
        },
        {
          "id": "memory",
          "name": "list_memory",
          "description": "List memory files in the current workspace.",
          "operation": "memory.list",
          "limit": 30
        }
      ]
    }
  }
}
