{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ai.dev/schema/plugin.schema.json",
  "title": "core-ai desktop plugin manifest",
  "type": "object",
  "required": ["name", "version", "coreai"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 500 },
    "coreai": {
      "type": "object",
      "required": ["schemaVersion", "id"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "desktopApi": { "type": "string", "maxLength": 40 },
        "engineApi": { "type": "string", "maxLength": 40 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["skills", "commands", "hooks", "agents", "mcp", "lsp"] },
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:*?\"<>|]+$" }
            },
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": { "enum": ["ui.dock", "ui.settings", "ui.composer", "ui.pages", "engine.skills", "media.assets.read", "media.assets.write", "media.models.read", "media.generate"] },
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": { "enum": ["ui.dock", "ui.settings", "ui.composer", "ui.pages", "engine.skills", "media.assets.read", "media.assets.write", "media.models.read", "media.generate"] },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "contributes": {
          "type": "object",
          "properties": {
            "dock": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "view": { "type": "string" },
                  "blocks": { "type": "array" }
                }
              }
            },
            "settings": { "type": "array" },
            "composer": { "type": "array" },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "view"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "view": { "type": "string" },
                  "icon": { "type": "string", "maxLength": 16 },
                  "scope": { "enum": ["workspace", "app"] }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
