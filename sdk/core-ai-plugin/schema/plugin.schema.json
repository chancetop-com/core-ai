{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ai.dev/schema/plugin.schema.json",
  "title": "core-ai desktop plugin manifest",
  "type": "object",
  "required": ["name", "version", "coreai"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 500 },
    "coreai": {
      "type": "object",
      "required": ["schemaVersion", "id"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "desktopApi": { "type": "string", "maxLength": 40 },
        "engineApi": { "type": "string", "maxLength": 40 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["skills", "commands", "hooks", "agents", "mcp", "lsp"] },
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:*?\"<>|]+$" }
            },
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": { "enum": ["ui.dock", "ui.settings", "ui.composer", "ui.pages", "ui.slots", "ui.renderers", "artifacts.read", "engine.skills", "prompt.sections", "browser.control", "media.assets.read", "media.assets.write", "media.models.read", "media.generate", "sessions.read", "sessions.write", "memory.read", "memory.write", "workspace.read", "usage.read", "plugin.storage", "events.read", "notification.send", "schedules.read", "schedules.write"] },
              "uniqueItems": true
            },
            "optional": {
              "type": "array",
              "items": { "enum": ["ui.dock", "ui.settings", "ui.composer", "ui.pages", "ui.slots", "ui.renderers", "artifacts.read", "engine.skills", "prompt.sections", "browser.control", "media.assets.read", "media.assets.write", "media.models.read", "media.generate", "sessions.read", "sessions.write", "memory.read", "memory.write", "workspace.read", "usage.read", "plugin.storage", "events.read", "notification.send", "schedules.read", "schedules.write"] },
              "uniqueItems": true
            }
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "version": { "type": "string" }
              }
            }
          },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "additionalProperties": false
        },
        "contributes": {
          "type": "object",
          "properties": {
            "dock": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "view": { "type": "string" },
                  "blocks": { "type": "array" }
                }
              }
            },
            "settings": { "type": "array" },
            "composer": { "type": "array" },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "view"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "view": { "type": "string" },
                  "icon": { "type": "string", "maxLength": 16 },
                  "scope": { "enum": ["workspace", "app"] }
                }
              }
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "slot", "title", "action"],
                "properties": {
                  "id": { "type": "string" },
                  "slot": { "enum": ["sidebar.footer.action", "composer.dock", "conversation.turn.tail", "conversation.message.actions"] },
                  "title": { "type": "string" },
                  "action": {
                    "type": "object",
                    "required": ["kind"],
                    "properties": {
                      "kind": { "enum": ["openPage", "insertText"] },
                      "pageId": { "type": "string" },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            },
            "renderers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "title", "pageId", "extensions"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "enum": ["artifact"] },
                  "title": { "type": "string" },
                  "pageId": { "type": "string" },
                  "extensions": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "promptSections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "content"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "operation"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "operation": { "enum": ["artifacts.list", "memory.list"] },
                  "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
                }
              }
            },
            "terminal": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "operation"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "operation": { "enum": ["git.status", "git.log", "git.diff", "node.version"] }
                }
              }
            },
            "guards": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "toolNames", "action"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "toolNames": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "action": { "enum": ["deny"] }
                }
              }
            },
            "sandboxProviders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "isolation"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "isolation": { "enum": ["process", "container", "os"] }
                }
              }
            },
            "agentActions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name", "description", "kind"],
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "kind": { "enum": ["start", "wait", "cancel", "list"] }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
